{"tree":[{"name":"README.md","type":"file","content":"# weatherly\n\nA small Python module and CLI for parsing and displaying weather data from an API response.\n\n## Requirements\n\n- Python 3.10 or higher\n- pytest (for running tests)\n\n## Installation\n\n```bash\ngit clone https://github.com/kiran-weather-dev/weatherly.git\ncd weatherly\npip install -r requirements.txt\n```\n\n## Usage\n\n```python\nfrom src.weather import parse_weather, format_output\n\n# Simulated API response\ndata = {\n    \"main\": {\"temp\": 28.4, \"humidity\": 72},\n    \"weather\": [{\"description\": \"partly cloudy\"}]\n}\n\nparsed = parse_weather(data)\nprint(format_output(parsed))\n# Temp: 28.4°C | Humidity: 72% | Partly cloudy\n```\n\n## CLI\n\n```bash\npython src/cli.py London\n```\n\n## Running tests\n\n```bash\npytest tests/\n```\n\n## License\n\nSee [LICENSE](LICENSE).\n"},{"name":"requirements.txt","type":"file","content":"pytest==8.3.3\n"},{"name":"src","type":"dir","children":[{"name":"cli.py","type":"file","content":"# cli.py — command-line entry point for weatherly\n# Usage: python cli.py <city>\n# In production this calls a weather API. Here it runs against a simulated response.\n\nimport sys\nfrom src.weather import get_weather\n\n# Simulated response — replace with a real requests.get() call in production\nDEMO_RESPONSE = {\n    \"main\": {\"temp\": 22.5, \"humidity\": 60},\n    \"weather\": [{\"description\": \"clear sky\"}],\n}\n\ndef main():\n    if len(sys.argv) < 2:\n        print(\"Usage: python cli.py <city>\")\n        sys.exit(1)\n    city = sys.argv[1]\n    print(f\"Weather for {city}:\")\n    print(get_weather(DEMO_RESPONSE))\n\nif __name__ == \"__main__\":\n    main()\n"},{"name":"weather.py","type":"file","content":"# weather.py — v1.0.0\n# Parses and displays weather data from an API response dict.\n\ndef parse_weather(data: dict) -> dict:\n    \"\"\"Parse weather data from an API response dict.\n\n    Returns a dict with temp, humidity, and description.\n    \"\"\"\n    temp = data[\"main\"][\"temp\"]\n    humidity = data[\"main\"][\"humidity\"]\n    description = data[\"weather\"][0][\"description\"]\n    return {\"temp\": temp, \"humidity\": humidity, \"description\": description}\n\n\ndef format_output(parsed: dict) -> str:\n    \"\"\"Format parsed weather data as a human-readable string.\"\"\"\n    return (\n        f\"Temp: {parsed['temp']}°C | \"\n        f\"Humidity: {parsed['humidity']}% | \"\n        f\"{parsed['description'].capitalize()}\"\n    )\n\n\ndef get_weather(data: dict) -> str:\n    \"\"\"Takes a raw API response dict, returns a formatted weather string.\"\"\"\n    parsed = parse_weather(data)\n    return format_output(parsed)\n"}]},{"name":"tests","type":"dir","children":[{"name":"test_weather.py","type":"file","content":"\"\"\"Tests for weatherly — HEAD version (v1.0.0).\"\"\"\n\nimport sys\nimport os\n\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\"))\n\nimport pytest\nfrom src.weather import parse_weather, format_output, get_weather\n\nVALID_RESPONSE = {\n    \"main\": {\"temp\": 22.5, \"humidity\": 60},\n    \"weather\": [{\"description\": \"clear sky\"}],\n}\n\n\ndef test_parse_weather_returns_expected_fields():\n    result = parse_weather(VALID_RESPONSE)\n    assert result[\"temp\"] == 22.5\n    assert result[\"humidity\"] == 60\n    assert result[\"description\"] == \"clear sky\"\n\n\ndef test_format_output_contains_temp():\n    result = format_output({\"temp\": 22.5, \"humidity\": 60, \"description\": \"clear sky\"})\n    assert \"22.5\" in result\n\n\ndef test_format_output_capitalises_description():\n    result = format_output({\"temp\": 10.0, \"humidity\": 50, \"description\": \"light rain\"})\n    assert \"Light rain\" in result\n\n\ndef test_get_weather_returns_string():\n    result = get_weather(VALID_RESPONSE)\n    assert isinstance(result, str)\n    assert \"22.5\" in result\n"}]}]}