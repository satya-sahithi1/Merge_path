{"tree":[{"name":"README.md","type":"file","content":"# weatherly\n\nA minimal command-line tool that fetches and displays current weather for a city using a weather API.\n\n## Requirements\n\n- Python 3.10 or higher\n- pytest (for running tests)\n\n## Installation\n\n```bash\ngit clone https://github.com/kiran-weather-dev/weatherly.git\ncd weatherly\npip install -r requirements.txt\n```\n\n## Usage\n\n```python\nfrom src.weather import parse_weather, format_output\n\n# Simulated API response\ndata = {\n    \"main\": {\"temp\": 28.4, \"humidity\": 72},\n    \"weather\": [{\"description\": \"partly cloudy\"}]\n}\n\nparsed = parse_weather(data)\nprint(format_output(parsed))\n# Temp: 28.4°C | Humidity: 72% | Partly cloudy\n```\n\n## Running tests\n\n```bash\npytest tests/\n```\n\n## License\n\nMIT\n"},{"name":"requirements.txt","type":"file","content":"pytest==8.3.3\n"},{"name":"src","type":"dir","children":[{"name":"weather.py","type":"file","content":"# weather.py — v1.0.0\n# A simple CLI tool that parses and displays weather data.\n# In production use this would call a weather API via requests.get().\n# Here we work directly with the response dict so the logic is testable.\n\ndef parse_weather(data: dict) -> dict:\n    \"\"\"Parse weather data from an API response dict.\n\n    Returns a dict with temp, humidity, and description.\n\n    Raises KeyError if the expected keys are missing from data.\n    \"\"\"\n    # BUG: No check for 'main' key before accessing it.\n    # The weather API recently changed its response format for some cities.\n    # When the API returns an error response or a different format,\n    # 'main' may not be present — this raises an unhandled KeyError.\n    temp = data[\"main\"][\"temp\"]\n    humidity = data[\"main\"][\"humidity\"]\n    description = data[\"weather\"][0][\"description\"]\n    return {\"temp\": temp, \"humidity\": humidity, \"description\": description}\n\n\ndef format_output(parsed: dict) -> str:\n    \"\"\"Format parsed weather data as a human-readable string.\"\"\"\n    return (\n        f\"Temp: {parsed['temp']}°C | \"\n        f\"Humidity: {parsed['humidity']}% | \"\n        f\"{parsed['description'].capitalize()}\"\n    )\n\n\ndef get_weather(data: dict) -> str:\n    \"\"\"Main entry point. Takes raw API response dict, returns formatted string.\"\"\"\n    parsed = parse_weather(data)\n    return format_output(parsed)\n"},{"name":"weather_fixed.py","type":"file","content":"# weather.py — v1.1.0\n# FIX: parse_weather now checks for the 'main' key before accessing it.\n# Returns a clean error dict instead of raising KeyError.\n\ndef parse_weather(data: dict) -> dict:\n    \"\"\"Parse weather data from an API response dict.\n\n    Returns a dict with temp, humidity, and description on success,\n    or a dict with 'error' key if the response format is unexpected.\n    \"\"\"\n    # FIX: Guard against missing 'main' key in the API response.\n    if \"main\" not in data:\n        return {\"error\": \"Unexpected API response format.\"}\n    temp = data[\"main\"][\"temp\"]\n    humidity = data[\"main\"][\"humidity\"]\n    description = data[\"weather\"][0][\"description\"]\n    return {\"temp\": temp, \"humidity\": humidity, \"description\": description}\n\n\ndef format_output(parsed: dict) -> str:\n    \"\"\"Format parsed weather data as a human-readable string.\"\"\"\n    return (\n        f\"Temp: {parsed['temp']}°C | \"\n        f\"Humidity: {parsed['humidity']}% | \"\n        f\"{parsed['description'].capitalize()}\"\n    )\n\n\ndef get_weather(data: dict) -> str:\n    \"\"\"Main entry point. Takes raw API response dict, returns formatted string.\"\"\"\n    parsed = parse_weather(data)\n    return format_output(parsed)\n"}]},{"name":"tests","type":"dir","children":[{"name":"test_weather.py","type":"file","content":"\"\"\"\nRegression tests for weatherly.\n\nEach test class covers one bug. Within each class:\n- test_buggy_*  shows the wrong behavior in v1.0.0\n- test_fixed_*  shows the correct behavior in v1.1.0\n\nThese tests are the source of truth for the scenario JSON.\nIf they pass, verifiedByTest can be set to true in issues.json.\n\"\"\"\n\nimport sys\nimport os\n\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\"))\n\nimport pytest\nfrom src.weather import parse_weather, get_weather\nfrom src.weather_fixed import parse_weather as parse_weather_fixed, get_weather as get_weather_fixed\n\n# ── Shared fixtures ────────────────────────────────────────────────────────\n\nVALID_RESPONSE = {\n    \"main\": {\"temp\": 22.5, \"humidity\": 60},\n    \"weather\": [{\"description\": \"clear sky\"}],\n}\n\nMISSING_MAIN_RESPONSE = {\n    \"cod\": 404,\n    \"message\": \"city not found\",\n}\n\n# ---------------------------------------------------------------------------\n# Bug 1 — KeyError when 'main' key missing from API response\n# regressionTestId: weatherly/missing-main-key\n# ---------------------------------------------------------------------------\n\nclass TestMissingMainKey:\n\n    def test_buggy_raises_keyerror_on_missing_main(self):\n        \"\"\"v1.0.0: parse_weather raises KeyError when 'main' is absent.\"\"\"\n        with pytest.raises(KeyError):\n            parse_weather(MISSING_MAIN_RESPONSE)\n\n    def test_fixed_returns_error_dict_on_missing_main(self):\n        \"\"\"v1.1.0: parse_weather returns a clean error dict.\"\"\"\n        result = parse_weather_fixed(MISSING_MAIN_RESPONSE)\n        assert result.get(\"error\") == \"Unexpected API response format.\"\n\n    def test_fixed_no_exception_raised(self):\n        \"\"\"v1.1.0: no exception raised on bad response.\"\"\"\n        try:\n            parse_weather_fixed(MISSING_MAIN_RESPONSE)\n        except KeyError:\n            pytest.fail(\"KeyError should not be raised in fixed version\")\n\n\n# ---------------------------------------------------------------------------\n# Valid response — both versions handle it correctly\n# ---------------------------------------------------------------------------\n\nclass TestValidResponse:\n\n    def test_buggy_parses_valid_response(self):\n        \"\"\"v1.0.0: correctly parses a well-formed API response.\"\"\"\n        result = parse_weather(VALID_RESPONSE)\n        assert result[\"temp\"] == 22.5\n        assert result[\"humidity\"] == 60\n        assert result[\"description\"] == \"clear sky\"\n\n    def test_fixed_parses_valid_response(self):\n        \"\"\"v1.1.0: correctly parses a well-formed API response.\"\"\"\n        result = parse_weather_fixed(VALID_RESPONSE)\n        assert result[\"temp\"] == 22.5\n        assert result[\"humidity\"] == 60\n        assert result[\"description\"] == \"clear sky\"\n\n    def test_buggy_formats_output(self):\n        \"\"\"v1.0.0: get_weather returns a formatted string for valid input.\"\"\"\n        result = get_weather(VALID_RESPONSE)\n        assert \"22.5\" in result\n        assert \"60\" in result\n\n    def test_fixed_formats_output(self):\n        \"\"\"v1.1.0: get_weather returns a formatted string for valid input.\"\"\"\n        result = get_weather_fixed(VALID_RESPONSE)\n        assert \"22.5\" in result\n        assert \"60\" in result\n"}]}]}